# App Configuration
APP_URL=https://your-app-url.vercel.app

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=your-postgresql-connection-string

# Canva Integration
NEXT_PUBLIC_CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_REDIRECT_URI=https://your-app-url.vercel.app/api/auth/canva/callback
CANVA_SCOPES=design:content:read design:content:write asset:read profile:read
CANVA_WEBHOOK_SECRET=your-canva-webhook-secret
